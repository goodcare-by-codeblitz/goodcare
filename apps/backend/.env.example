# Backend environment variables
# Copy this to .env and fill in your values

# JWT signing secret (min 32 characters)
JWT_SECRET=

# Cookie signing secret
COOKIE_SECRET=

# Server port (optional, defaults to 3000)
PORT=5000

# Comma-separated frontend origins allowed for CORS
# Example: http://localhost:3001,http://127.0.0.1:3001
CORS_ORIGIN=http://localhost:3001
APP_PROTOCOL=http
APP_BASE_DOMAIN=goodcare.local:3000

# Platform superadmin credentials (used by seed script and auth)
PLATFORM_SUPERUSER_EMAIL=
PLATFORM_SUPERUSER_PASSWORD=

# SendGrid API key for transactional emails
SENDGRID_API_KEY=

# Redis connection URL for BullMQ job queue
REDIS_URL=redis://localhost:6379

# Super user email for initial setup (used by seed script and auth )
SUPER_USER_EMAIL=
