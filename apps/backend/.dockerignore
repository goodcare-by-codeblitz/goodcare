# Docker build context exclusions for optimized builds
# 
# This .dockerignore file speeds up Docker builds by excluding unnecessary files
# from the Docker build context. Only required files are sent to the Docker daemon.

# Version control
.git
.gitignore
.gitattributes

# Dependency directories (will be installed in container)
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
*.tsbuildinfo

# Environment files (should be provided at runtime, not in image)
.env
.env.local
.env.*.local
.env.production

# IDE and editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project

# Documentation
README.md
CONTRIBUTING.md
LICENSE
docs/
*.md

# Testing
__tests__
__mocks__
.test.ts
*.test.ts
*.spec.ts
vitest.config.ts
coverage/
.nyc_output

# CI/CD and development
.github
.gitlab-ci.yml
.circleci
.travis.yml
Jenkinsfile
.env.ci

# Docker files (not needed in image)
Dockerfile
docker-compose.yml
.dockerignore

# Platform-specific development
.next
.cache
tmp/
temp/

# Package manager cache
.pnpm-store
.yarn/cache

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
*.pem
*.p8

# Misc
.cache
.turbo
turbo.json
