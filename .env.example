# Goodcare Local Development Environment Configuration
#
# This file serves as a TEMPLATE. Copy it to .env and fill in actual values.
# IMPORTANT: .env is gitignored and should NEVER be committed to version control.
# NEVER hardcode secrets in this template or commit to the repository.
#
# To get started:
#   1. Copy this file: cp .env.example .env
#   2. Fill in any custom values (most have safe defaults for local development)
#   3. Run: docker compose up --build

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string for Prisma
# Format: postgresql://user:password@host:port/database
# Default: postgres user with password 'postgres' connecting to 'goodcare' database
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/goodcare

# PostgreSQL root user (used by postgres image and Prisma migrations)
POSTGRES_USER=postgres

# PostgreSQL root password (used by postgres image and database connections)
POSTGRES_PASSWORD=postgres

# PostgreSQL database name to create on first startup
POSTGRES_DB=goodcare

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis connection string (used by BullMQ job queue and email worker)
# Format: redis://[password@]host:port[/db]
# Default: connects to redis service on default port 6379, no password, db 0
REDIS_URL=redis://redis:6379

# ============================================================================
# Backend Configuration
# ============================================================================

# Backend server port (exposed to host machine)
PORT=3000

# Host port mapping (used in docker-compose.yml)
# This maps docker port 3000 to your local machine port
BACKEND_PORT=3000

# Node environment
NODE_ENV=development

# ============================================================================
# Security: JWT and Cookies
# ============================================================================

# Secret key for signing JSON Web Tokens (JWT)
# IMPORTANT: Change this to a random secure value in production
# Generate with: openssl rand -base64 32 (or any secure random generator)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Secret key for signing secure cookies
# IMPORTANT: Change this to a random secure value in production
# Generate with: openssl rand -base64 32
COOKIE_SECRET=your_cookie_secret_key_change_this_in_production

# Secret key used to hash refresh/session tokens (required for auth flows)
# IMPORTANT: Must be set; registration/login fails if missing.
# Generate with: openssl rand -base64 32
TOKEN_HASH_SECRET=your_token_hash_secret_key_change_this_in_production

# ============================================================================
# Platform Superuser (Initial Admin Account)
# ============================================================================

# Email address for the initial platform superuser (seeded on first startup)
# This is the account with full PLATFORM scope permissions
PLATFORM_SUPERUSER_EMAIL=admin@goodcare.local

# Password for the platform superuser
# IMPORTANT: Change this to a secure password for production
# The seed script uses this to create the initial superadmin account
PLATFORM_SUPERUSER_PASSWORD=SuperUser@123

# ============================================================================
# Email Configuration (Optional - for email queue/worker)
# ============================================================================

# Email service provider URL (if applicable)
# Example: smtp://user:pass@smtp.example.com:587
EMAIL_SERVICE_URL=

# Email sender address (from address for emails sent by the system)
EMAIL_FROM=noreply@goodcare.local

# ============================================================================
# Additional Service URLs (if needed)
# ============================================================================

# Frontend URL (used for links in emails, invitations, etc.)
# Default: http://localhost:3000 (match your local setup)
FRONTEND_URL=http://localhost:3000

# ============================================================================
# Debugging & Logging
# ============================================================================

# Enable debug logging in the backend
DEBUG=

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info

# ============================================================================
# Notes
# ============================================================================
#
# 1. NEVER commit .env to version control. The .gitignore file excludes it.
#
# 2. For Docker Compose: All of these values are injected into containers
#    as environment variables. You can override them at runtime:
#    docker compose run --env VARIABLE=value backend npm run dev
#
# 3. Database migrations and seeding:
#    - The db-init service runs automatically on first docker compose up
#    - It creates roles, permissions, and the superuser account
#    - Subsequent runs do not re-seed; only new migrations are applied
#
# 4. Troubleshooting:
#    - If migrations fail, check logs: docker compose logs db-init
#    - To reset database completely: docker compose down -v
#    - To view database: docker compose exec postgres psql -U postgres -d goodcare
#
# 5. Production Security Recommendations:
#    - Use strong random values for JWT_SECRET and COOKIE_SECRET
#    - Use a secure random password for PLATFORM_SUPERUSER_PASSWORD
#    - Use environment variables from a secrets manager (AWS Secrets, HashiCorp Vault, etc.)
#    - Never expose .env files or logs containing secrets
#    - Rotate secrets regularly
#    - Use HTTPS for all communications
#
